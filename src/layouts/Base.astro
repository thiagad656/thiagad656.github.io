---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import Icone from '../components/Icone.astro';

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const perfil = (await getEntry('perfil', 'perfil'))!.data;

const atualizado = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Sao_Paulo',
}).format(new Date());

const naHome = Astro.url.pathname === '/';
const base = naHome ? '' : '/';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#11151c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="barra" data-barra>
      <div class="topo">
        <a class="marca" href="/" data-marca data-na-home={naHome ? 'sim' : undefined}>{perfil.nome}</a>
        <nav aria-label="Principal">
          <a href={`${base}#trabalho`}>Trabalho</a>
          <a href={`${base}#trajetoria`}>Trajetória</a>
          <a href={`${base}#contato`}>Contato</a>
        </nav>
      </div>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="faixa-rodape">
      <div class="rodape">
        <ul class="redes" aria-label="Contato">
          {
            perfil.linkedin && (
              <li>
                <a href={perfil.linkedin}>
                  <Icone nome="linkedin" />
                  LinkedIn
                </a>
              </li>
            )
          }
          {
            perfil.github && (
              <li>
                <a href={perfil.github}>
                  <Icone nome="github" />
                  GitHub
                </a>
              </li>
            )
          }
          {
            perfil.email && (
              <li>
                <a href={`mailto:${perfil.email}`}>
                  <Icone nome="email" />
                  E-mail
                </a>
              </li>
            )
          }
        </ul>
        <p>Última atualização: {atualizado}.</p>
        <p>
          Feito com Astro.{' '}
          <a href="https://github.com/thiagad656/thiagad656.github.io">Código no GitHub</a>.
        </p>
      </div>
    </footer>
    <script>
      // Na home, o nome só aparece na barra depois que o título grande sai da tela.
      const marca = document.querySelector('[data-marca]');

      const titulo = document.getElementById('nome');
      if (marca?.dataset.naHome && titulo) {
        marca.classList.add('escondida');
        new IntersectionObserver(([entrada]) => {
          marca.classList.toggle('escondida', entrada.isIntersecting);
        }).observe(titulo);
      }
    </script>
  </body>
</html>

<style>
  .pular {
    position: absolute;
    left: 1rem;
    top: -3rem;
    background: var(--destaque);
    color: var(--fundo);
    padding: 0.4rem 0.8rem;
    z-index: 1;
  }
  .pular:focus {
    top: 1rem;
  }
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--preto);
    border-bottom: 1px solid var(--linha);
  }
  .topo,
  main,
  .rodape {
    max-width: var(--medida);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  .topo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 1rem;
  }
  .marca {
    font-family: var(--serifa);
    font-size: 1.15rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .marca.escondida {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .marca {
      transition: none;
    }
  }
  @media (max-width: 30rem) {
    .marca {
      display: none;
    }
    .topo {
      justify-content: flex-end;
    }
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    color: var(--texto-suave);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--texto);
  }
  .faixa-rodape {
    margin-top: 5rem;
    background: var(--preto);
    border-top: 1px solid var(--linha);
  }
  .rodape {
    padding-block: 2.5rem 3rem;
    color: var(--texto-suave);
    font-size: 0.85rem;
  }
  .redes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    padding: 0;
    margin: 0 0 1.75rem;
    font-size: 0.95rem;
  }
  .redes a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--texto);
    text-decoration: none;
  }
  .redes a:hover {
    color: var(--destaque);
  }
  .rodape p {
    margin: 0 0 0.25rem;
  }
  .rodape a {
    color: var(--texto-suave);
  }
</style>
