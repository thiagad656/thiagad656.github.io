---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Fontes from '../../components/Fontes.astro';
import { criarCaderno } from '../../lib/fontes';

export async function getStaticPaths() {
  const trabalhos = await getCollection('trabalho');
  return trabalhos.map((t) => ({ params: { slug: t.id }, props: { t } }));
}

const { t } = Astro.props;
const d = t.data;

const caderno = criarCaderno();
const lide = caderno.marcar(d.lide, d.fontes, t.id);
const corpo = caderno.marcar(t.rendered?.html ?? '', d.fontes, t.id);
const resumo = d.lide.replace(/\[\[([^|\]]+)\|[^\]]+\]\]/g, '$1').replace(/\s+/g, ' ').trim();
---

<Base titulo={`${d.titulo}, por Thiago da Silva`} descricao={resumo}>
  <article>
    <header class="cabeca">
      <p class="meta">{d.tipo}. {d.onde}, {d.periodo}.</p>
      <h1>{d.titulo}</h1>
      <p class="lide" set:html={lide} />
    </header>

    {
      d.imagem && (
        <figure>
          <img src={d.imagem.src} alt={d.imagem.alt} loading="lazy" />
        </figure>
      )
    }

    {
      d.rascunho && import.meta.env.DEV && (
        <p class="aviso">Rascunho: revise o bloco "O que eu faria diferente" e troque rascunho para false.</p>
      )
    }

    <div class="corpo" set:html={corpo} />

    <dl class="ficha">
      <div>
        <dt>Ferramentas</dt>
        <dd>{d.stack.join(', ')}</dd>
      </div>
      {
        d.links.length > 0 && (
          <div>
            <dt>Links</dt>
            <dd>
              {d.links.map((l, i) => (
                <>
                  {i > 0 && <br />}
                  <a href={l.url}>{l.texto}</a>
                </>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <Fontes notas={caderno.notas} />
  </article>
</Base>

<style>
  .cabeca {
    padding-block: 2.5rem 1rem;
  }
  .meta {
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  h1 {
    font-size: clamp(2.1rem, 6vw, 3.1rem);
    margin-bottom: 1.25rem;
  }
  .lide {
    font-size: 1.15rem;
  }
  figure {
    margin: 2rem 0;
    background: #f4f5f2;
    border-radius: 4px;
    padding: 1rem;
    text-align: center;
  }
  figure img {
    max-width: 100%;
    max-height: 32rem;
    height: auto;
  }
  .aviso {
    border: 1px dashed var(--destaque);
    padding: 0.75rem 1rem;
    color: var(--destaque);
    font-size: 0.9rem;
  }
  .corpo :global(h2) {
    font-size: 1.5rem;
    margin: 2.75rem 0 1rem;
  }
  .corpo :global(ul) {
    padding-left: 1.1rem;
  }
  .corpo :global(li) {
    margin-bottom: 0.75rem;
  }
  .corpo :global(li::marker) {
    color: var(--texto-suave);
  }
  .ficha {
    margin: 3rem 0 0;
  }
  .ficha div {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 0 1.5rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--linha);
  }
  dt {
    color: var(--texto-suave);
  }
  dd {
    margin: 0;
  }
  @media (max-width: 34rem) {
    .ficha div {
      grid-template-columns: 1fr;
    }
  }
</style>
